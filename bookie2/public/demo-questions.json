[{"id":"w1","context":"거북이가 토끼에게 시합을 하자고 말했어요.","prompt":"시합은 어떤 일인가요?","options":["규칙을 정해 겨루기","혼자 잠을 자기","친구를 기다리기"]},{"id":"w2","context":"토끼는 햇빛을 피하려고 나무 그늘에 누웠어요.","prompt":"그늘은 어떤 곳인가요?","options":["물이 흐르는 곳","빛이 가려진 곳","높이 솟은 곳"]},{"id":"w3","context":"거북이는 꾸준히 걸었어요.","prompt":"꾸준히와 가장 가까운 말은 무엇인가요?","options":["갑자기","어쩌다가","계속해서"]},{"id":"w4","context":"거북이가 결승선을 넘자 시합이 끝났어요.","prompt":"결승선은 어디에 있나요?","options":["시합을 시작하는 곳","시합을 끝내는 곳","잠깐 쉬는 곳"]},{"id":"w5","context":"아이는 들어갈까 말까 문 앞에서 망설였어요.","prompt":"망설였다는 것은 어떤 뜻인가요?","options":["바로 달려갔다","이미 끝냈다","쉽게 결정하지 못했다"]},{"id":"w6","context":"토끼가 거북이보다 앞서 달렸어요.","prompt":"앞서다와 반대되는 말은 무엇인가요?","options":["뒤처지다","서두르다","달려가다"]},{"id":"w7","context":"거북이가 함께 달리자는 제안을 했어요.","prompt":"제안은 어떤 행동인가요?","options":["했던 일을 감추기","함께 할 의견을 내기","다른 말을 못 듣기"]},{"id":"w8","context":"토끼는 반드시 이길 거라 믿고 방심했어요.","prompt":"이때 토끼의 마음과 가까운 것은 무엇인가요?","options":["계속 주의하며 살핀다","실수할까 걱정한다","괜찮다며 주의를 놓는다"]},{"id":"w9","context":"시합의 결과는 거북이의 승리였어요.","prompt":"결과를 가리키는 말은 무엇인가요?","options":["거북이가 이겼다","왜 달리게 됐을까","누가 출발 신호를 낼까"]},{"id":"w10","context":"시간이 충분해서 서두르지 않아도 돼요.","prompt":"여기서 충분하다는 뜻은 무엇인가요?","options":["필요한 만큼 넉넉하다","조금도 남지 않았다","이미 모두 지나갔다"]},{"id":"w11","context":"오래 걸은 끝에 마침내 도착했어요.","prompt":"마침내 대신 넣을 수 있는 말은 무엇인가요?","options":["가끔","드디어","미리"]},{"id":"w12","context":"토끼는 거북이가 어디 있는지 확인했어요.","prompt":"확인은 어떤 행동인가요?","options":["모르는 척하기","그냥 짐작하기","살펴서 알아보기"]}]